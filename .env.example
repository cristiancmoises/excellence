# Copy to .env only to customize settings. Do not publish keys.
# PT-BR: Copie para .env apenas para personalizar. Não publique chaves.
EXCELLENCE_BIND=127.0.0.1
EXCELLENCE_PORT=3210
# To publish through an HTTPS proxy:
# PT-BR: Para publicar através de proxy HTTPS:
# EXCELLENCE_PUBLIC_URL=https://excellence.example.org
# EXCELLENCE_SECURE_COOKIE=true
# Configure only the providers you want to use:
# PT-BR: Configure somente os provedores desejados:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# OLLAMA_NUM_THREAD=2
# With deploy/compose.ollama.yaml, opt in to the rate-limited public demo:
# PT-BR: Com deploy/compose.ollama.yaml, habilite a demonstração pública com limites:
# EXCELLENCE_DEMO_AI=true
